SPLIT_VALUE = 20
REQ_LIMIT_PER_SEC = 1
MAX_RETRIES = 3

# --- Data ---
ALL_POINTS_RAW = [
    126.95042955033101, 37.39952907832974,
    126.95100890747277, 37.39935861417968,
    126.95184575668353, 37.399171103167795,
